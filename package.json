{
  "name": "secretaria-controle",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit false --emitDeclarationOnly false",
    "cf:types": "wrangler types",
    "db:local": "wrangler d1 execute secretaria-db --local --file=./migrations/0001_schema.sql && wrangler d1 execute secretaria-db --local --file=./migrations/0002_seed.sql",
    "db:remote": "wrangler d1 execute secretaria-db --remote --file=./migrations/0001_schema.sql && wrangler d1 execute secretaria-db --remote --file=./migrations/0002_seed.sql",
    "db:acesso": "wrangler d1 execute secretaria-db --remote --file=./migrations/0003_acesso.sql",
    "db:backup": "wrangler d1 export secretaria-db --remote --output=backup.sql",
    "start": "npm run build && wrangler dev",
    "deploy": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "lucide-react": "^0.469.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^2.15.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20241230.0",
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^26.4.1",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.2",
    "vite": "^6.0.7",
    "wrangler": "^3.99.0"
  }
}
